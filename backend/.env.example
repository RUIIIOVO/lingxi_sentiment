# 复制为 .env 并填入自己的值，或直接 export 到环境变量。

# ---- MySQL ----
LINGXI_DB_HOST=127.0.0.1
LINGXI_DB_PORT=3306
LINGXI_DB_USER=root
LINGXI_DB_PASSWORD=
LINGXI_DB_NAME=lingxi

# ---- Django ----
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# ---- 爬虫 Cookie ----
# 各站登录后从浏览器开发者工具的请求头里复制整行 Cookie。
# 留空则对应站点的抓取会拿不到数据。
WEIBO_COOKIE=
BAIDU_COOKIE=
ZHIHU_COOKIE=
SINA_COOKIE=
